# 墨屿公网入口 —— 生产配置（证书就绪后由 start-gateway.sh 渲染并 reload）。
# HTTPS 终止 + HTTP->HTTPS 跳转 + ACME 续期验证路径；内部转发 web:8080
# （web 容器内 nginx 再分派 /v1 与 WebSocket）。

map $http_upgrade $connection_upgrade {
	default upgrade;
	'' close;
}

server {
	listen 80;
	server_name _;

	location = /healthz {
		access_log off;
		default_type text/plain;
		return 200 "ok\n";
	}

	location ^~ /.well-known/acme-challenge/ {
		root /var/www/certbot;
		default_type text/plain;
	}

	location / {
		return 301 https://$host$request_uri;
	}
}

server {
	listen 443 ssl;
	http2 on;
	server_name _;

	resolver 127.0.0.11 valid=30s ipv6=off;

	ssl_certificate /etc/letsencrypt/live/__PUBLIC_IP__/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/__PUBLIC_IP__/privkey.pem;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_session_cache shared:TLS:10m;
	ssl_session_timeout 1d;
	ssl_session_tickets off;

	client_max_body_size 100m;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto https;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $connection_upgrade;
	# 实时协同为长连接 WebSocket，禁止默认短超时切断（doc 26 §59）。
	proxy_buffering off;
	proxy_read_timeout 24h;
	proxy_send_timeout 24h;

	location / {
		set $web_upstream web:8080;
		proxy_pass http://$web_upstream;
	}
}