{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://contracts.dom.internal/queries/comments/list-comments.schema.json",
	"title": "ListCommentsResponse",
	"description": "FR-CMT-002. List flat-thread comments of a Resource, oldest first.",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"resourceId": { "$ref": "../../ids/ids.schema.json#/$defs/ResourceId" },
		"items": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"commentId": { "$ref": "../../ids/ids.schema.json#/$defs/CommentId" },
					"threadId": {
						"$ref": "../../ids/ids.schema.json#/$defs/ThreadId"
					},
					"authorAccountId": {
						"$ref": "../../ids/ids.schema.json#/$defs/UserId"
					},
					"body": { "type": "string" },
					"anchor": { "type": "object" },
					"createdAt": { "type": "string", "format": "date-time" },
					"status": { "enum": ["Open", "Resolved", "Detached"] },
					"createdBy": { "$ref": "../../ids/ids.schema.json#/$defs/UserId" },
					"resolvedAt": { "type": ["string", "null"], "format": "date-time" },
					"resolvedBy": {
						"oneOf": [
							{ "$ref": "../../ids/ids.schema.json#/$defs/UserId" },
							{ "type": "null" }
						]
					}
				},
				"required": [
					"commentId",
					"threadId",
					"authorAccountId",
					"body",
					"anchor",
					"createdAt",
					"status",
					"createdBy",
					"resolvedAt",
					"resolvedBy"
				]
			}
		}
	},
	"required": ["resourceId", "items"]
}
