{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://contracts.dom.internal/queries/workspace/list-folder-children.schema.json",
	"title": "ListFolderChildrenResponse",
	"description": "FR-WRL-004/005. List immediate Folder metadata children only; no Resource content is returned.",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"projectId": { "$ref": "../../ids/ids.schema.json#/$defs/ProjectId" },
		"parentFolderId": {
			"oneOf": [
				{ "$ref": "../../ids/ids.schema.json#/$defs/FolderId" },
				{ "type": "null" }
			]
		},
		"items": { "type": "array", "items": { "$ref": "#/$defs/FolderSummary" } },
		"nextCursor": { "type": ["string", "null"] }
	},
	"required": ["projectId", "parentFolderId", "items", "nextCursor"],
	"$defs": {
		"FolderSummary": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"folderId": { "$ref": "../../ids/ids.schema.json#/$defs/FolderId" },
				"name": { "type": "string" },
				"lifecycle": {
					"type": "string",
					"enum": ["Active", "Trashed", "Deleted"]
				},
				"hasChildren": { "type": "boolean" }
			},
			"required": ["folderId", "name", "lifecycle", "hasChildren"],
			"title": "FolderSummary"
		}
	}
}
