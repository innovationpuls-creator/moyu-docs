{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://contracts.dom.internal/queries/workspace/list-workspaces.schema.json",
	"title": "ListWorkspacesResponse",
	"description": "FR-WRL-003. List Workspace metadata records the authenticated Account is a member of (Owner or Member), newest first. Authority: Permission membership.",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"workspaces": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"workspaceId": {
						"$ref": "../../ids/ids.schema.json#/$defs/WorkspaceId"
					},
					"name": { "type": "string" },
					"membershipKind": { "type": "string", "enum": ["Owner", "Member"] },
					"lifecycle": {
						"type": "string",
						"enum": ["Active", "DeletionPending", "Deleted"]
					},
					"createdAt": { "type": "string", "format": "date-time" }
				},
				"required": [
					"workspaceId",
					"name",
					"membershipKind",
					"lifecycle",
					"createdAt"
				]
			}
		}
	},
	"required": ["workspaces"]
}
