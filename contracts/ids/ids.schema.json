{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://contracts.dom.internal/ids/ids.schema.json",
	"title": "IdentityIds",
	"description": "Canonical ID types plus shared cross-contract value enums (doc 28 §9-§11). All business IDs, including InvitationId, use UUIDv7. The shared value enums AccountStatusValue, SessionStatusValue and SessionReplacementReason are co-located here (doc 27 §52 freezes no directory for shared enums) so their generated class names stay globally unique across the contract tree — one canonical definition, referenced everywhere via $ref. The registry logical name IdentityIds therefore covers both the ID types and these shared value enums. The root is the identity surface manifest: one property per canonical ID type, declared so that every ID type is projected in every target language (doc 28 §42/§46). It is not a transport payload and no field is required.",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"userId": {
			"$ref": "#/$defs/UserId"
		},
		"workspaceId": {
			"$ref": "#/$defs/WorkspaceId"
		},
		"invitationId": {
			"$ref": "#/$defs/InvitationId"
		},
		"projectId": {
			"$ref": "#/$defs/ProjectId"
		},
		"folderId": {
			"$ref": "#/$defs/FolderId"
		},
		"resourceId": {
			"$ref": "#/$defs/ResourceId"
		},
		"changesetId": {
			"$ref": "#/$defs/ChangeSetId"
		},
		"nodeId": {
			"$ref": "#/$defs/NodeId"
		},
		"taskId": {
			"$ref": "#/$defs/TaskId"
		},
		"attemptId": {
			"$ref": "#/$defs/AttemptId"
		},
		"commentId": {
			"$ref": "#/$defs/CommentId"
		},
		"threadId": {
			"$ref": "#/$defs/ThreadId"
		},
		"assetId": {
			"$ref": "#/$defs/AssetId"
		},
		"eventId": {
			"$ref": "#/$defs/EventId"
		},
		"requestId": {
			"$ref": "#/$defs/RequestId"
		},
		"operationId": {
			"$ref": "#/$defs/OperationId"
		},
		"sessionId": {
			"$ref": "#/$defs/SessionId"
		},
		"subscriptionId": {
			"$ref": "#/$defs/SubscriptionId"
		},
		"shareId": {
			"$ref": "#/$defs/ShareId"
		},
		"deliveryId": {
			"$ref": "#/$defs/DeliveryId"
		},
		"idempotencyKey": {
			"$ref": "#/$defs/IdempotencyKey"
		},
		"accountStatusValue": {
			"$ref": "#/$defs/AccountStatusValue"
		},
		"sessionStatusValue": {
			"$ref": "#/$defs/SessionStatusValue"
		},
		"sessionReplacementReason": {
			"$ref": "#/$defs/SessionReplacementReason"
		},
		"nodeRef": {
			"$ref": "#/$defs/NodeRef"
		}
	},
	"$defs": {
		"UserId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "UserId"
		},
		"WorkspaceId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "WorkspaceId"
		},
		"InvitationId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "InvitationId"
		},
		"ProjectId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "ProjectId"
		},
		"FolderId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "FolderId"
		},
		"ResourceId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "ResourceId"
		},
		"ChangeSetId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "ChangeSetId"
		},
		"NodeId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "NodeId"
		},
		"TaskId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "TaskId"
		},
		"AttemptId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "AttemptId"
		},
		"CommentId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "CommentId"
		},
		"ThreadId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "ThreadId"
		},
		"AssetId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "AssetId"
		},
		"EventId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "EventId"
		},
		"RequestId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "RequestId"
		},
		"OperationId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "OperationId"
		},
		"SessionId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "SessionId"
		},
		"SubscriptionId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "SubscriptionId"
		},
		"ShareId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "ShareId"
		},
		"DeliveryId": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "DeliveryId"
		},
		"IdempotencyKey": {
			"type": "string",
			"format": "uuid",
			"x-uuid-version": 7,
			"title": "IdempotencyKey"
		},
		"NodeRef": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"resourceId": {
					"$ref": "#/$defs/ResourceId"
				},
				"nodeId": {
					"$ref": "#/$defs/NodeId"
				}
			},
			"required": ["resourceId", "nodeId"],
			"title": "NodeRef"
		},
		"AccountStatusValue": {
			"type": "string",
			"enum": [
				"PendingVerification",
				"Active",
				"Disabled",
				"DeletionPending",
				"Deleted"
			],
			"title": "AccountStatusValue"
		},
		"SessionStatusValue": {
			"type": "string",
			"enum": ["Active", "Replaced", "LoggedOut", "Expired", "Revoked"],
			"title": "SessionStatusValue"
		},
		"SessionReplacementReason": {
			"type": "string",
			"enum": [
				"NewDeviceLogin",
				"UserLogout",
				"PasswordReset",
				"AccountDisabled",
				"Expired",
				"SecurityRevoke"
			],
			"title": "SessionReplacementReason"
		}
	}
}
