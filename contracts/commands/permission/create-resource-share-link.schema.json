{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://contracts.dom.internal/commands/permission/create-resource-share-link.schema.json",
	"title": "CreateResourceShareLink",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"expiresAt": {
			"anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
		}
	},
	"required": ["expiresAt"],
	"$defs": {
		"CreateResourceShareLinkResponse": {
			"title": "CreateResourceShareLinkResponse",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"shareLink": {
					"$ref": "../../queries/permission/list-resource-share-links.schema.json#/$defs/ShareLinkMetadata"
				},
				"shareUrl": { "type": "string", "minLength": 1 }
			},
			"required": ["shareLink", "shareUrl"]
		}
	}
}
