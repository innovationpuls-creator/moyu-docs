{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://contracts.dom.internal/commands/workspace/rename-project.schema.json",
	"title": "RenameProject",
	"description": "FR-WRL-003. Rename Project metadata; sibling collision comparison is canonical and display value is preserved.",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"projectId": { "$ref": "../../ids/ids.schema.json#/$defs/ProjectId" },
		"name": { "type": "string", "minLength": 1, "maxLength": 120 },
		"idempotencyKey": {
			"$ref": "../../ids/ids.schema.json#/$defs/IdempotencyKey"
		}
	},
	"required": ["projectId", "name", "idempotencyKey"],
	"$defs": {
		"RenameProjectResponse": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"projectId": { "$ref": "../../ids/ids.schema.json#/$defs/ProjectId" },
				"name": { "type": "string" },
				"updatedAt": { "type": "string", "format": "date-time" }
			},
			"required": ["projectId", "name", "updatedAt"],
			"title": "RenameProjectResponse"
		}
	}
}
