{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://contracts.dom.internal/commands/auth/reset-password.schema.json",
	"title": "ResetPassword",
	"description": "FR-AUTH-025/026/027. Single-use, 15-minute reset token in the request body, marked x-sensitive (doc 28 §57). Token is never echoed in the response. On success all old sessions are invalidated and no new session is auto-created (PRD FR-AUTH-027).",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"token": {
			"type": "string",
			"x-sensitive": true
		},
		"newPassword": {
			"type": "string",
			"minLength": 12,
			"maxLength": 128,
			"x-sensitive": true
		}
	},
	"required": ["token", "newPassword"],
	"$defs": {
		"ResetPasswordResponse": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"messageKey": {
					"type": "string",
					"minLength": 1
				},
				"accountStatus": {
					"$ref": "../../ids/ids.schema.json#/$defs/AccountStatusValue"
				}
			},
			"required": ["messageKey", "accountStatus"],
			"title": "ResetPasswordResponse"
		}
	}
}
