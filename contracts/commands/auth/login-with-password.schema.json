{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://contracts.dom.internal/commands/auth/login-with-password.schema.json",
	"title": "LoginWithPassword",
	"description": "FR-AUTH-006. Response carries account status, the current session summary, and whether the caller is forced into Account Recovery Mode (PRD FR-AUTH-032: DeletionPending -> recovery mode only). The session credential is delivered as a Secure/HttpOnly Set-Cookie (modeled in OpenAPI), not in this body.",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"email": {
			"type": "string",
			"format": "email"
		},
		"password": {
			"type": "string",
			"x-sensitive": true
		}
	},
	"required": ["email", "password"],
	"$defs": {
		"LoginWithPasswordResponse": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"accountId": {
					"$ref": "../../ids/ids.schema.json#/$defs/UserId"
				},
				"accountStatus": {
					"$ref": "../../ids/ids.schema.json#/$defs/AccountStatusValue"
				},
				"session": {
					"$ref": "#/$defs/SessionSummary"
				},
				"recoveryModeRequired": {
					"type": "boolean"
				}
			},
			"required": [
				"accountId",
				"accountStatus",
				"session",
				"recoveryModeRequired"
			],
			"title": "LoginWithPasswordResponse"
		},
		"SessionSummary": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"sessionId": {
					"$ref": "../../ids/ids.schema.json#/$defs/SessionId"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"lastSeenAt": {
					"type": "string",
					"format": "date-time"
				},
				"expiresAt": {
					"type": "string",
					"format": "date-time"
				},
				"currentDevice": {
					"type": "boolean"
				},
				"status": {
					"$ref": "../../ids/ids.schema.json#/$defs/SessionStatusValue"
				},
				"lastStrongAuthAt": {
					"type": ["string", "null"],
					"format": "date-time"
				}
			},
			"required": [
				"sessionId",
				"createdAt",
				"lastSeenAt",
				"expiresAt",
				"currentDevice",
				"status"
			],
			"title": "SessionSummary"
		}
	}
}
