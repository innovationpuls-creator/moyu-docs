{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://contracts.dom.internal/commands/auth/logout.schema.json",
	"title": "Logout",
	"description": "FR-AUTH-020. Idempotent (BDD 'logout is idempotent'). The request carries no body; the session is resolved from the auth context. The response is representable even when the session was already invalid (sessionStatus = AlreadyLoggedOut).",
	"type": "object",
	"additionalProperties": false,
	"properties": {},
	"$defs": {
		"LogoutResponse": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"messageKey": {
					"type": "string",
					"minLength": 1
				},
				"sessionStatus": {
					"$ref": "#/$defs/LogoutStatusValue"
				}
			},
			"required": ["messageKey", "sessionStatus"],
			"title": "LogoutResponse"
		},
		"LogoutStatusValue": {
			"type": "string",
			"enum": ["LoggedOut", "AlreadyLoggedOut"],
			"title": "LogoutStatusValue"
		}
	}
}
