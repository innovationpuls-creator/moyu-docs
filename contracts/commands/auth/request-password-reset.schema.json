{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://contracts.dom.internal/commands/auth/request-password-reset.schema.json",
	"title": "RequestPasswordReset",
	"description": "FR-AUTH-024. Anti-enumeration: identical external response whether or not the email is registered (PRD FR-AUTH-007). Rate-limited (AC-024.3). The request carries only the email; the reset link is delivered out-of-band.",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"email": {
			"type": "string",
			"format": "email"
		}
	},
	"required": ["email"],
	"$defs": {
		"RequestPasswordResetResponse": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"messageKey": {
					"type": "string",
					"minLength": 1
				},
				"nextAllowedAt": {
					"type": "string",
					"format": "date-time"
				}
			},
			"required": ["messageKey", "nextAllowedAt"],
			"title": "RequestPasswordResetResponse"
		}
	}
}
