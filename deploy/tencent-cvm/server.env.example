# Copy to server.env and fill this file before staging the deployment bundle.
# Never commit server.env; it contains production credentials.

DOMAIN=app.example.com

# URI-encode reserved characters in the database username and password.
DATABASE_URL=postgresql+psycopg://dom_app:REPLACE_ME@postgres.private.example:5432/dom?sslmode=require
REALTIME_DATABASE_URL=postgresql://dom_app:REPLACE_ME@postgres.private.example:5432/dom?sslmode=require

# Example for a COS bucket in Shanghai. Use the exact bucket name including APPID.
S3_ASSET_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
S3_ASSET_REGION=ap-shanghai
S3_ASSET_BUCKET=dom-assets-1250000000
S3_ASSET_ACCESS_KEY=REPLACE_ME
S3_ASSET_SECRET_KEY=REPLACE_ME

# Generate each separately with: openssl rand -base64 32
INVITATION_IDEMPOTENCY_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
SHARE_LINK_IDEMPOTENCY_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM="DOM <noreply@example.com>"
SMTP_STARTTLS=1
